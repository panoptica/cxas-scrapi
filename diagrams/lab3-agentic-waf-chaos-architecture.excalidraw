        }
      ]
    },
    {
      "id": "txt_366",
      "type": "text",
      "x": 872,
      "y": 1670,
      "width": 816,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 368,
      "version": 1,
      "versionNonce": 736,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\ud83c\udfdb\ufe0f Google Cloud Well-Architected Framework: The 5 Agentic Pillars\n\u2022 Operational Excellence: CI/CD 7-Gate automation pipeline, AST static linter, telemetry DTOs.\n\u2022 Security, Privacy & Compliance: Two-Plane Identity (Auth Gate), Zero-Trust tool payloads,\n  Defense-in-depth secret scrubbing (after_tool_callback), PII redaction.\n\u2022 Reliability: Client SLA timeouts (5s), State-managed circuit breakers (1-retry cap),\n  Deterministic graceful degradation routes (submit_support_ticket fallback).\n\u2022 Performance Optimization: Gemini Composite V1 temperature tuning (1.0 vs 0.2 deadlock),\n  Spoken tool pacing directives ([T014] conversational filler phrases preventing dead air).\n\u2022 Cost Optimization: Token conservation via Clean Data Facades, runaway loop termination.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "rect_365",
      "originalText": "\ud83c\udfdb\ufe0f Google Cloud Well-Architected Framework: The 5 Agentic Pillars\n\u2022 Operational Excellence: CI/CD 7-Gate automation pipeline, AST static linter, telemetry DTOs.\n\u2022 Security, Privacy & Compliance: Two-Plane Identity (Auth Gate), Zero-Trust tool payloads,\n  Defense-in-depth secret scrubbing (after_tool_callback), PII redaction.\n\u2022 Reliability: Client SLA timeouts (5s), State-managed circuit breakers (1-retry cap),\n  Deterministic graceful degradation routes (submit_support_ticket fallback).\n\u2022 Performance Optimization: Gemini Composite V1 temperature tuning (1.0 vs 0.2 deadlock),\n  Spoken tool pacing directives ([T014] conversational filler phrases preventing dead air).\n\u2022 Cost Optimization: Token conservation via Clean Data Facades, runaway loop termination.",
      "lineHeight": 1.25
    },
    {
      "id": "rect_369",
