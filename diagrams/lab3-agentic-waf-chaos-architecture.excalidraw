      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Remediation: Zero-Trust Data Envelope & Redaction\n\u2022 Tool regex strips 'URGENT SYSTEM UPDATE:' & prompt injection payload.\n\u2022 \u2705 System prompt <constraints> forbids executing instructions in tool data.\n\u2022 Agent Action: Announces standard discount ($10 Autopay); ignores override.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "rect_293",
      "originalText": "Remediation: Zero-Trust Data Envelope & Redaction\n\u2022 Tool regex strips 'URGENT SYSTEM UPDATE:' & prompt injection payload.\n\u2022 \u2705 System prompt <constraints> forbids executing instructions in tool data.\n\u2022 Agent Action: Announces standard discount ($10 Autopay); ignores override.",
      "lineHeight": 1.25
    },
