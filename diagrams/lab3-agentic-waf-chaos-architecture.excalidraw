      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WAF: Security & Privacy (Two-Plane Identity & Guardrail Interceptor)\n\u2022 Interceptor: before_agent_callback initializes auth_status='unauthenticated'.\n\u2022 Interceptor: before_model_callback enforces synchronous auth gate.\n\u2022 Deterministic Policy: Blocks model/tool invocation before any context is generated.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "rect_225",
      "originalText": "WAF: Security & Privacy (Two-Plane Identity & Guardrail Interceptor)\n\u2022 Interceptor: before_agent_callback initializes auth_status='unauthenticated'.\n\u2022 Interceptor: before_model_callback enforces synchronous auth gate.\n\u2022 Deterministic Policy: Blocks model/tool invocation before any context is generated.",
      "lineHeight": 1.25
    },
